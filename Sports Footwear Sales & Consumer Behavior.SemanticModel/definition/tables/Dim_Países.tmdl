/// Países donde se realizaron las ventas.
table Dim_Países
	lineageTag: 45a916a5-4e1c-4e2d-8ba2-5723c7353806

	/// Clave sustituta generada en Power Query.
	column 'Índice País'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: eab3befb-fd99-411b-9bf3-31e0d30cb9b3
		summarizeBy: none
		sourceColumn: Índice País

		annotation SummarizationSetBy = Automatic

	/// País de la venta.
	column País
		dataType: string
		lineageTag: 3fdecacb-06e7-450a-97d6-0f1016fa5333
		summarizeBy: none
		sourceColumn: País

		annotation SummarizationSetBy = Automatic

	/// Bandera del país (imagen SVG incrustada).
	column Bandera
		dataType: string
		lineageTag: 2e9f6b14-7d3a-4c85-a1f0-6b4e8c2d9a57
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: Bandera

		annotation SummarizationSetBy = Automatic

	/// Bandera en base64, para incrustarla dentro del gráfico SVG de la página Mercados.
	column 'Bandera Base64'
		dataType: string
		isHidden
		lineageTag: 8b2c5e71-4a9d-4f06-b3e8-1d7a6c9f2e48
		summarizeBy: none
		sourceColumn: Bandera Base64

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Dim_Países = m
		mode: import
		queryGroup: Dimensiones
		source =
				let
				    Paises = fnCrearDimension(Ventas_Origen, "País", "Índice País"),
				    ConBandera = Table.NestedJoin(Paises, {"País"}, Banderas, {"País"}, "Banderas", JoinKind.LeftOuter),
				    BanderaExpandida = Table.ExpandTableColumn(ConBandera, "Banderas", {"Bandera", "Bandera Base64"})
				in
				    BanderaExpandida

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

