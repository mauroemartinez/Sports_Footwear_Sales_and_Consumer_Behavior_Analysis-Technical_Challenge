/// Tabla contenedora de todas las medidas del modelo, organizadas en carpetas.
table Medidas
	lineageTag: 20e647f4-bc6d-457c-b4b9-28ca4fba3d50

	/// Suma de los ingresos de las órdenes, en USD.
	measure 'Ingresos en USD' = SUM(Fact_Dataframe[Ingresos en USD])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Métricas Base
		lineageTag: 1cbdf1c4-4333-4cf9-8dd3-0ea3dc2a2b31

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Suma de unidades vendidas.
	measure 'Unidades Vendidas' = SUM(Fact_Dataframe[Unidades Vendidas])
		formatString: #,0
		displayFolder: Métricas Base
		lineageTag: ece9cd10-122e-4856-8612-69e5a4481fec

	/// Promedio de la calificación del cliente (escala 3 a 5) por orden.
	measure 'Promedio Calificación de Cliente' = AVERAGE(Fact_Dataframe[Calificación del Cliente])
		formatString: 0.00
		displayFolder: Métricas Base
		lineageTag: 5e82c6c2-5f24-4c6c-bd1b-a06381297e2a

	/// Color hexadecimal para formato condicional según el color de producto, el género o la banda de calificación en contexto.
	measure 'Mapeo de Colores' =
			VAR ColorSeleccionado = SELECTEDVALUE(Fact_Dataframe[Color])
			VAR GeneroSeleccionado = SELECTEDVALUE(Fact_Dataframe[Género])
			VAR CalificacionSeleccionada = SELECTEDVALUE(Fact_Dataframe[Categoría Calificación])
			VAR MapeoColor =
			    SWITCH(
			        ColorSeleccionado,
			        "Negro", "#6B7178",
			        "Gris", "#8D9AA8",
			        "Rojo", "#EF6661",
			        "Azul", "#4081D2",
			        "Blanco", "#F0EEE9"
			    )
			VAR MapeoGenero =
			    SWITCH(
			        GeneroSeleccionado,
			        "Masculino", "#0DA4CF",
			        "Femenino", "#E78A45",
			        "Unisex", "#8D9AA8"
			    )
			VAR MapeoCalificacion =
			    SWITCH(
			        CalificacionSeleccionada,
			        "Muy mala", "#EF6661",
			        "Mala", "#A5524D",
			        "Buena", "#247996",
			        "Muy buena", "#0DA4CF"
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        ISINSCOPE(Fact_Dataframe[Color]) && NOT ISBLANK(MapeoColor), MapeoColor,
			        ISINSCOPE(Fact_Dataframe[Género]) && NOT ISBLANK(MapeoGenero), MapeoGenero,
			        ISINSCOPE(Fact_Dataframe[Categoría Calificación]) && NOT ISBLANK(MapeoCalificacion), MapeoCalificacion,
			        "#0DA4CF"
			    )
		displayFolder: Cosméticos
		lineageTag: 1ec4f710-a212-4312-b626-ab00cfc9ced0

	/// Cantidad de órdenes (una fila por orden en Fact_Dataframe).
	measure 'Cantidad Órdenes' = COUNTROWS(Fact_Dataframe)
		formatString: #,0
		displayFolder: Métricas Base
		lineageTag: 463d0d3a-efd8-4de3-8c2a-a0f1d029898f

	/// Ingreso promedio por orden, en USD.
	measure 'Ingresos Promedio' = DIVIDE([Ingresos en USD], [Cantidad Órdenes])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Métricas Base
		lineageTag: 9bc6eec8-47f1-4883-acbf-e441f74ece5a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Valor de la métrica elegida en el parámetro de campo Métrica.
	measure 'Métrica Dinámica Valor' =
			VAR MetricaSeleccionada = MAX('Métrica'[Métrica])
			RETURN
			    SWITCH(
			        MetricaSeleccionada,
			        "Ingresos en USD", [Ingresos en USD],
			        "Unidades Vendidas", [Unidades Vendidas],
			        "Cantidad Órdenes", [Cantidad Órdenes],
			        "Ingresos Promedio", [Ingresos Promedio],
			        "Promedio Calificación de Cliente", [Promedio Calificación de Cliente]
			    )
		displayFolder: Métricas Dinámicas
		lineageTag: bbfb392b-3c46-4327-beb4-515e17dd2ef9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Participación del elemento sobre el total visible de la métrica elegida. Vacío para métricas de promedio.
	measure '% del Total Visible' =
			VAR NombreMetrica = MAX('Métrica'[Métrica])
			VAR EsPromedio = NombreMetrica IN {"Ingresos Promedio", "Promedio Calificación de Cliente"}
			VAR ValorMetrica = [Métrica Dinámica Valor]
			VAR TotalVisible = CALCULATE([Métrica Dinámica Valor], ALLSELECTED())
			RETURN
			    IF(NOT EsPromedio, DIVIDE(ValorMetrica, TotalVisible))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Métricas Dinámicas
		lineageTag: 8da22283-c49d-418e-b995-b0aa1c17b0db

	/// Ingresos del mismo período del año anterior.
	measure 'Ingresos LY' = CALCULATE([Ingresos en USD], SAMEPERIODLASTYEAR(Calendario[Fecha]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: 2ccbde72-884e-4e72-ad93-f48669903e37

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Variación porcentual de ingresos contra el año anterior. Vacío cuando no hay año anterior.
	measure 'YoY % Ingresos' =
			VAR Actual = [Ingresos en USD]
			VAR Anterior = [Ingresos LY]
			RETURN
			    DIVIDE(Actual - Anterior, Anterior)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: c20f1189-e9d6-4746-bbe7-31fc538d824d

	/// Color para formato condicional de la variación interanual: rojo si cae, celeste si crece.
	measure 'Color YoY %' = IF([YoY % Ingresos] < 0, "#EF6661", "#0DA4CF")
		displayFolder: Cosméticos
		lineageTag: 18af7ea2-64f6-4884-a7a5-d48d105d8c7a

	/// Promedio de los ingresos mensuales de los últimos 3 meses. Solo se calcula a nivel de mes y cuando hay 3 meses completos de historia.
	measure 'Promedio Móvil 3 Meses' =
			VAR UltimaFecha = MAX(Calendario[Fecha])
			VAR Periodo = DATESINPERIOD(Calendario[Fecha], UltimaFecha, -3, MONTH)
			VAR PrimeraFechaVentas = CALCULATE(MIN(Fact_Dataframe[Fecha]), REMOVEFILTERS())
			VAR InicioVentana = EOMONTH(UltimaFecha, -3) + 1
			VAR HayTresMeses = InicioVentana >= PrimeraFechaVentas
			RETURN
			    IF(
			        HASONEVALUE(Calendario[Inicio Mes]) && HayTresMeses,
			        CALCULATE(
			            AVERAGEX(VALUES(Calendario[Inicio Mes]), [Ingresos en USD]),
			            Periodo
			        )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: 6b5a64cd-e062-46b9-b1ff-b5849a2d67b5

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Máximo del eje Y del gráfico de tendencia: el mayor valor mensual entre ingresos y promedio móvil, más 2%.
	measure 'Máximo + % para Eje Y Promedio Móvil vs Ingresos en USD' =
			VAR Meses = CALCULATETABLE(VALUES(Calendario[Inicio Mes]), ALLSELECTED(Calendario))
			VAR MaxIngreso = MAXX(Meses, [Ingresos en USD])
			VAR MaxPromedio = MAXX(Meses, [Promedio Móvil 3 Meses])
			RETURN
			    MAX(MaxIngreso, MaxPromedio) * 1.02
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Cosméticos
		lineageTag: e608f92f-d288-4331-bc13-c28a860d14fc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Título del gráfico de Overview según la métrica y la categoría elegidas.
	measure 'Título Dinámico por Métrica' = MAX('Métrica'[Métrica]) & " por " & MAX('Categorías'[Categorías])
		displayFolder: Cosméticos
		lineageTag: 8db6061a-5eeb-4d05-8aa7-baa3263fcd72

	/// Gráfico de columnas en SVG para las vistas por país de Overview: la métrica elegida en el parámetro, con la bandera bajo cada barra.
	measure 'Gráfico por País Overview' =
			VAR Metrica = IF(ISFILTERED('Métrica'), MAX('Métrica'[Métrica]), "Ingresos en USD")
			VAR Datos =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Dim_Países'[País]),
			            "@Valor",
			                SWITCH(
			                    Metrica,
			                    "Cantidad Órdenes", [Cantidad Órdenes],
			                    "Unidades Vendidas", [Unidades Vendidas],
			                    "Ingresos Promedio", [Ingresos Promedio],
			                    "Promedio Calificación de Cliente", [Promedio Calificación de Cliente],
			                    [Ingresos en USD]
			                ),
			            "@Bandera", CALCULATE(MAX('Dim_Países'[Bandera Base64]))
			        ),
			        NOT ISBLANK([@Valor])
			    )
			VAR Cantidad = COUNTROWS(Datos)
			VAR Maximo = MAXX(Datos, [@Valor])
			VAR Ancho = 940
			VAR Base = 212
			VAR AltoMaximo = 170
			VAR Espacio = DIVIDE(Ancho, Cantidad)
			VAR AnchoBarra = MIN(Espacio * 0.55, 110)
			VAR Barras =
			    CONCATENATEX(
			        ADDCOLUMNS(Datos, "@Posicion", RANKX(Datos, [@Valor], , DESC, Dense)),
			        VAR Centro = Espacio * ([@Posicion] - 1) + Espacio / 2
			        VAR Alto = AltoMaximo * DIVIDE([@Valor], Maximo)
			        VAR Etiqueta =
			            SWITCH(
			                Metrica,
			                "Ingresos en USD", "$" & FORMAT([@Valor] / 1000000, "0.00", "es-AR") & "M",
			                "Ingresos Promedio", "$" & FORMAT([@Valor], "#,0.00", "es-AR"),
			                "Promedio Calificación de Cliente", FORMAT([@Valor], "0.00", "es-AR"),
			                FORMAT([@Valor], "#,0", "es-AR")
			            )
			        RETURN
			            "<rect x='" & FORMAT(Centro - AnchoBarra / 2, "0.0", "en-US") & "' y='" & FORMAT(Base - Alto, "0.0", "en-US")
			                & "' width='" & FORMAT(AnchoBarra, "0.0", "en-US") & "' height='" & FORMAT(Alto, "0.0", "en-US")
			                & "' rx='4' fill='%230DA4CF'/>"
			            & "<text x='" & FORMAT(Centro, "0.0", "en-US") & "' y='" & FORMAT(Base - Alto - 10, "0.0", "en-US")
			                & "' text-anchor='middle' font-family='Segoe UI' font-size='16' fill='%23F0EEE9'>" & Etiqueta & "</text>"
			            & "<image xlink:href='" & [@Bandera] & "' x='" & FORMAT(Centro - 22, "0.0", "en-US") & "' y='" & (Base + 12)
			                & "' width='44' height='30' preserveAspectRatio='none'/>"
			            & "<text x='" & FORMAT(Centro, "0.0", "en-US") & "' y='" & (Base + 66)
			                & "' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='%23BBC5D1'>" & 'Dim_Países'[País] & "</text>",
			        "",
			        [@Posicion], ASC
			    )
			RETURN
			    IF(
			        Cantidad > 0,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' width='940' height='300' viewBox='0 0 940 300'>"
			            & "<line x1='0' y1='" & Base & "' x2='940' y2='" & Base & "' stroke='%232A394D'/>" & Barras & "</svg>"
			    )
		displayFolder: Cosméticos
		dataCategory: ImageUrl
		lineageTag: 9d4f2a6b-1e8c-4b37-a5d0-7c3e9b2f6a18

	/// Altura fija para la capa invisible que da tooltip al gráfico SVG de Overview: una columna igual por cada país con datos.
	measure 'Base Tooltip' = IF(NOT ISBLANK([Métrica Dinámica Valor]), 1)
		formatString: 0
		isHidden
		displayFolder: Tooltip
		lineageTag: 1b7e4c90-3f6a-4d28-9c15-8e2d5a7b3f64

	/// Diferencia de ingresos contra el año anterior, en USD. Vacío cuando no hay año anterior.
	measure 'Ingresos YoY' = IF(NOT ISBLANK([Ingresos LY]), [Ingresos en USD] - [Ingresos LY])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: 880518b3-0f89-499f-a374-eb69ddfb29a7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Participación de cada país en los ingresos de los países visibles.
	measure '% Ingresos por País' = DIVIDE([Ingresos en USD], CALCULATE([Ingresos en USD], ALLSELECTED('Dim_Países')))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Métricas Base
		lineageTag: 5d8a3f62-9c1e-4b07-8e2a-4f6c1d9b7e30

	/// Bandera del país señalado, para la página de tooltip. Vacía si el elemento señalado no es un país.
	measure 'Bandera Seleccionada' =
			IF(
			    HASONEVALUE('Dim_Países'[País])
			        && (NOT ISFILTERED('Categorías') || MAX('Categorías'[Categorías]) = "País"),
			    SELECTEDVALUE('Dim_Países'[Bandera])
			)
		displayFolder: Tooltip
		lineageTag: 0f6e2d8a-5b1c-4e97-a3f4-9c2b7d1e6a85
		dataCategory: ImageUrl

	/// Nombre del elemento señalado, según la categoría elegida en el parámetro (o el país, fuera del gráfico de Overview).
	measure 'Elemento Seleccionado' =
			IF(
			    NOT ISFILTERED('Categorías'),
			    SELECTEDVALUE('Dim_Países'[País]),
			SWITCH(
			    MAX('Categorías'[Categorías]),
			    "Canal de Venta", SELECTEDVALUE('Canales de Venta'[Canal de Venta]),
			    "Categoría", SELECTEDVALUE('Dim_Categoría'[Categoría]),
			    "Color", SELECTEDVALUE(Fact_Dataframe[Color]),
			    "Calificación del Cliente", "Calificación " & FORMAT(SELECTEDVALUE(Fact_Dataframe[Calificación del Cliente]), "0.0"),
			    "Categoría de Clasificación", SELECTEDVALUE(Fact_Dataframe[Categoría Calificación]),
			    "Género", SELECTEDVALUE(Fact_Dataframe[Género]),
			    "Marca", SELECTEDVALUE('Dim_Marcas'[Marca]),
			    "Método de Pago", SELECTEDVALUE('Dim_Métodos de Pago'[Método de Pago]),
			    "Nivel de Ingresos del Cliente", "Ingresos " & SELECTEDVALUE(Fact_Dataframe[Nivel de Ingresos del Cliente]),
			    "Modelo", "Modelo " & SELECTEDVALUE(Fact_Dataframe[Modelo]),
			    "País", SELECTEDVALUE('Dim_Países'[País]),
			    "Talle", "Talle " & SELECTEDVALUE(Fact_Dataframe[Talle])
			)
			)
		displayFolder: Tooltip
		lineageTag: 3a9c7e15-2d4b-4f80-96e1-5b8d2c7f0a36

	/// Gráfico de columnas en SVG con los ingresos por país y la bandera de cada país bajo su barra. Respeta los filtros.
	measure 'Gráfico Ingresos por País' =
			VAR Datos =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Dim_Países'[País]),
			            "@Valor", [Ingresos en USD],
			            "@Bandera", CALCULATE(MAX('Dim_Países'[Bandera Base64]))
			        ),
			        NOT ISBLANK([@Valor])
			    )
			VAR Cantidad = COUNTROWS(Datos)
			VAR Maximo = MAXX(Datos, [@Valor])
			VAR Ancho = 1180
			VAR Base = 112
			VAR AltoMaximo = 82
			VAR Espacio = DIVIDE(Ancho, Cantidad)
			VAR AnchoBarra = MIN(Espacio * 0.5, 120)
			VAR Barras =
			    CONCATENATEX(
			        ADDCOLUMNS(Datos, "@Posicion", RANKX(Datos, [@Valor], , DESC, Dense)),
			        VAR Centro = Espacio * ([@Posicion] - 1) + Espacio / 2
			        VAR Alto = AltoMaximo * DIVIDE([@Valor], Maximo)
			        RETURN
			            "<rect x='" & FORMAT(Centro - AnchoBarra / 2, "0.0", "en-US") & "' y='" & FORMAT(Base - Alto, "0.0", "en-US")
			                & "' width='" & FORMAT(AnchoBarra, "0.0", "en-US") & "' height='" & FORMAT(Alto, "0.0", "en-US")
			                & "' rx='4' fill='%230DA4CF'/>"
			            & "<text x='" & FORMAT(Centro, "0.0", "en-US") & "' y='" & FORMAT(Base - Alto - 8, "0.0", "en-US")
			                & "' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='%23F0EEE9'>$"
			                & FORMAT([@Valor] / 1000000, "0.00", "es-AR") & "M</text>"
			            & "<image xlink:href='" & [@Bandera] & "' x='" & FORMAT(Centro - 18, "0.0", "en-US") & "' y='" & (Base + 10)
			                & "' width='36' height='24' preserveAspectRatio='none'/>"
			            & "<text x='" & FORMAT(Centro, "0.0", "en-US") & "' y='" & (Base + 54)
			                & "' text-anchor='middle' font-family='Segoe UI' font-size='13' fill='%23BBC5D1'>" & 'Dim_Países'[País] & "</text>",
			        "",
			        [@Posicion], ASC
			    )
			RETURN
			    IF(
			        Cantidad > 0,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' width='1180' height='175' viewBox='0 0 1180 175'>"
			            & "<line x1='0' y1='" & Base & "' x2='1180' y2='" & Base & "' stroke='%232A394D'/>" & Barras & "</svg>"
			    )
		displayFolder: Cosméticos
		lineageTag: 6e1b9d47-8c3a-4f25-b0d6-2a7e4c9f1b53
		dataCategory: ImageUrl

	partition Medidas = m
		mode: import
		queryGroup: Medidas
		source =
				let
				    TablaVacia = #table(type table [Medidas = text], {}),
				    SinColumnas = Table.RemoveColumns(TablaVacia, {"Medidas"})
				in
				    SinColumnas

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

