/// Ubicación del CSV de origen: una URL (http/https) o una ruta local completa al archivo. Por defecto, la copia publicada en el repositorio de GitHub.
expression OrigenDatos = "https://raw.githubusercontent.com/mauroemartinez/Sports_Footwear_Sales_and_Consumer_Behavior_Analysis-Technical_Challenge/main/Data/global_sports_footwear_sales_2018_2026.csv" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 3f1c2a7e-8b54-4d0e-9a61-2c7d5e9b1a01
	queryGroup: Parámetros

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Text

/// Devuelve una dimensión con los valores distintos de una columna, ordenados y con una clave entera desde 1.
expression fnCrearDimension =
		(tabla as table, columna as text, nombreClave as text) as table =>
		let
		    ValoresDistintos = Table.Distinct(Table.SelectColumns(tabla, {columna})),
		    ValoresOrdenados = Table.Sort(ValoresDistintos, {{columna, Order.Ascending}}),
		    ConClave = Table.AddIndexColumn(ValoresOrdenados, nombreClave, 1, 1, Int64.Type),
		    ColumnasOrdenadas = Table.ReorderColumns(ConClave, {nombreClave, columna})
		in
		    ColumnasOrdenadas
	lineageTag: 6a2e9d41-0c3b-4f8a-b7e5-91d2c4a6f802
	queryGroup: Funciones

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

/// Ventas limpias a nivel de orden. Base de la tabla de hechos y de todas las dimensiones; no se carga al modelo.
expression Ventas_Origen =
		let
		    // Lee el CSV desde una URL o desde un archivo local, según OrigenDatos
		    Contenido = if Text.StartsWith(OrigenDatos, "http") then Web.Contents(OrigenDatos) else File.Contents(OrigenDatos),
		    Origen = Csv.Document(Contenido, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
		    // Tipos explícitos con cultura en-US: el CSV usa punto como separador decimal
		    TiposDefinidos = Table.TransformColumnTypes(
		        EncabezadosPromovidos,
		        {
		            {"order_id", type text}, {"order_date", type date}, {"brand", type text},
		            {"model_name", type text}, {"category", type text}, {"gender", type text},
		            {"size", Int64.Type}, {"color", type text}, {"base_price_usd", Int64.Type},
		            {"discount_percent", Int64.Type}, {"final_price_usd", Currency.Type},
		            {"units_sold", Int64.Type}, {"revenue_usd", Currency.Type},
		            {"payment_method", type text}, {"sales_channel", type text}, {"country", type text},
		            {"customer_income_level", type text}, {"customer_rating", type number}
		        },
		        "en-US"
		    ),
		    ColumnasRenombradas = Table.RenameColumns(
		        TiposDefinidos,
		        {
		            {"order_id", "ID Orden"}, {"order_date", "Fecha"}, {"brand", "Marca"},
		            {"model_name", "Modelo"}, {"category", "Categoría"}, {"gender", "Género"},
		            {"size", "Talle"}, {"color", "Color"}, {"base_price_usd", "Precio Base USD"},
		            {"discount_percent", "% Descuento"}, {"final_price_usd", "Precio Final USD"},
		            {"units_sold", "Unidades Vendidas"}, {"revenue_usd", "Ingresos en USD"},
		            {"payment_method", "Método de Pago"}, {"sales_channel", "Canal de Venta"},
		            {"country", "País"}, {"customer_income_level", "Nivel de Ingresos del Cliente"},
		            {"customer_rating", "Calificación del Cliente"}
		        }
		    ),
		    // Traducción de valores por coincidencia exacta; los valores sin traducción se conservan
		    Traducciones = [
		        Género = [Men = "Masculino", Women = "Femenino"],
		        Color = [Black = "Negro", Grey = "Gris", Red = "Rojo", Blue = "Azul", White = "Blanco"],
		        #"Método de Pago" = [Card = "Tarjeta", Cash = "Efectivo", #"Bank Transfer" = "Transferencia", Wallet = "Billetera"],
		        #"Nivel de Ingresos del Cliente" = [Low = "Bajo", Medium = "Medio", High = "Alto"]
		    ],
		    ValoresTraducidos = Table.TransformColumns(
		        ColumnasRenombradas,
		        List.Transform(
		            Record.FieldNames(Traducciones),
		            (columna) => {columna, (valor) => Record.FieldOrDefault(Record.Field(Traducciones, columna), valor, valor), type text}
		        )
		    ),
		    // "Model-370" -> 370
		    ModeloNumerico = Table.TransformColumns(ValoresTraducidos, {{"Modelo", each Number.From(Text.AfterDelimiter(_, "-")), Int64.Type}}),
		    // 15 -> 0,15
		    DescuentoComoPorcentaje = Table.TransformColumns(ModeloNumerico, {{"% Descuento", each _ / 100, Percentage.Type}})
		in
		    DescuentoComoPorcentaje
	lineageTag: 9d7b3c18-5e2f-4a90-8c4d-7f1e0b2a3c03
	queryGroup: Transformación

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

/// Bandera de cada país (SVG 3:2), en dos formatos: texto para tablas y base64 para incrustar en otros SVG.
expression Banderas =
		let
		    Fuente = #table(
		        type table [País = text, SVG = text],
		        {
		            {"Germany", "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40' viewBox='0 0 30 20' preserveAspectRatio='none'><rect width='30' height='6.667' fill='#000'/><rect y='6.667' width='30' height='6.667' fill='#DD0000'/><rect y='13.333' width='30' height='6.667' fill='#FFCE00'/></svg>"},
		            {"India", "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40' viewBox='0 0 30 20' preserveAspectRatio='none'><rect width='30' height='6.667' fill='#FF9933'/><rect y='6.667' width='30' height='6.667' fill='#FFFFFF'/><rect y='13.333' width='30' height='6.667' fill='#138808'/><circle cx='15' cy='10' r='2.6' fill='none' stroke='#000080' stroke-width='0.35'/><line x1='15' y1='10' x2='17.600' y2='10.000' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='17.511' y2='10.673' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='17.252' y2='11.300' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='16.838' y2='11.838' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='16.300' y2='12.252' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='15.673' y2='12.511' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='15.000' y2='12.600' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='14.327' y2='12.511' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='13.700' y2='12.252' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='13.162' y2='11.838' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='12.748' y2='11.300' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='12.489' y2='10.673' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='12.400' y2='10.000' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='12.489' y2='9.327' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='12.748' y2='8.700' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='13.162' y2='8.162' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='13.700' y2='7.748' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='14.327' y2='7.489' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='15.000' y2='7.400' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='15.673' y2='7.489' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='16.300' y2='7.748' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='16.838' y2='8.162' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='17.252' y2='8.700' stroke='#000080' stroke-width='0.12'/><line x1='15' y1='10' x2='17.511' y2='9.327' stroke='#000080' stroke-width='0.12'/><circle cx='15' cy='10' r='0.45' fill='#000080'/></svg>"},
		            {"Pakistan", "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40' viewBox='0 0 30 20' preserveAspectRatio='none'><rect width='30' height='20' fill='#01411C'/><rect width='7.5' height='20' fill='#FFFFFF'/><circle cx='18.6' cy='10.4' r='5.6' fill='#FFFFFF'/><circle cx='20.1' cy='8.9' r='5.0' fill='#01411C'/><polygon points='23.150,5.528 22.921,6.723 23.963,7.353 22.755,7.505 22.478,8.691 21.960,7.589 20.747,7.691 21.635,6.859 21.162,5.737 22.229,6.324' fill='#FFFFFF'/></svg>"},
		            {"UAE", "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40' viewBox='0 0 30 20' preserveAspectRatio='none'><rect width='30' height='6.667' fill='#00732F'/><rect y='6.667' width='30' height='6.667' fill='#FFFFFF'/><rect y='13.333' width='30' height='6.667' fill='#000000'/><rect width='7.5' height='20' fill='#FF0000'/></svg>"},
		            {"UK", "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40' viewBox='0 0 60 30' preserveAspectRatio='none'><clipPath id='t'><path d='M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z'/></clipPath><path d='M0,0 v30 h60 v-30 z' fill='#012169'/><path d='M0,0 L60,30 M60,0 L0,30' stroke='#FFFFFF' stroke-width='6'/><path d='M0,0 L60,30 M60,0 L0,30' clip-path='url(#t)' stroke='#C8102E' stroke-width='4'/><path d='M30,0 v30 M0,15 h60' stroke='#FFFFFF' stroke-width='10'/><path d='M30,0 v30 M0,15 h60' stroke='#C8102E' stroke-width='6'/></svg>"},
		            {"USA", "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40' viewBox='0 0 7410 3900' preserveAspectRatio='none'><rect width='7410' height='3900' fill='#FFFFFF'/><rect y='0' width='7410' height='300' fill='#B22234'/><rect y='600' width='7410' height='300' fill='#B22234'/><rect y='1200' width='7410' height='300' fill='#B22234'/><rect y='1800' width='7410' height='300' fill='#B22234'/><rect y='2400' width='7410' height='300' fill='#B22234'/><rect y='3000' width='7410' height='300' fill='#B22234'/><rect y='3600' width='7410' height='300' fill='#B22234'/><rect width='2964' height='2100' fill='#3C3B6E'/><circle cx='247' cy='210' r='95' fill='#FFFFFF'/><circle cx='741' cy='210' r='95' fill='#FFFFFF'/><circle cx='1235' cy='210' r='95' fill='#FFFFFF'/><circle cx='1729' cy='210' r='95' fill='#FFFFFF'/><circle cx='2223' cy='210' r='95' fill='#FFFFFF'/><circle cx='2717' cy='210' r='95' fill='#FFFFFF'/><circle cx='494' cy='420' r='95' fill='#FFFFFF'/><circle cx='988' cy='420' r='95' fill='#FFFFFF'/><circle cx='1482' cy='420' r='95' fill='#FFFFFF'/><circle cx='1976' cy='420' r='95' fill='#FFFFFF'/><circle cx='2470' cy='420' r='95' fill='#FFFFFF'/><circle cx='247' cy='630' r='95' fill='#FFFFFF'/><circle cx='741' cy='630' r='95' fill='#FFFFFF'/><circle cx='1235' cy='630' r='95' fill='#FFFFFF'/><circle cx='1729' cy='630' r='95' fill='#FFFFFF'/><circle cx='2223' cy='630' r='95' fill='#FFFFFF'/><circle cx='2717' cy='630' r='95' fill='#FFFFFF'/><circle cx='494' cy='840' r='95' fill='#FFFFFF'/><circle cx='988' cy='840' r='95' fill='#FFFFFF'/><circle cx='1482' cy='840' r='95' fill='#FFFFFF'/><circle cx='1976' cy='840' r='95' fill='#FFFFFF'/><circle cx='2470' cy='840' r='95' fill='#FFFFFF'/><circle cx='247' cy='1050' r='95' fill='#FFFFFF'/><circle cx='741' cy='1050' r='95' fill='#FFFFFF'/><circle cx='1235' cy='1050' r='95' fill='#FFFFFF'/><circle cx='1729' cy='1050' r='95' fill='#FFFFFF'/><circle cx='2223' cy='1050' r='95' fill='#FFFFFF'/><circle cx='2717' cy='1050' r='95' fill='#FFFFFF'/><circle cx='494' cy='1260' r='95' fill='#FFFFFF'/><circle cx='988' cy='1260' r='95' fill='#FFFFFF'/><circle cx='1482' cy='1260' r='95' fill='#FFFFFF'/><circle cx='1976' cy='1260' r='95' fill='#FFFFFF'/><circle cx='2470' cy='1260' r='95' fill='#FFFFFF'/><circle cx='247' cy='1470' r='95' fill='#FFFFFF'/><circle cx='741' cy='1470' r='95' fill='#FFFFFF'/><circle cx='1235' cy='1470' r='95' fill='#FFFFFF'/><circle cx='1729' cy='1470' r='95' fill='#FFFFFF'/><circle cx='2223' cy='1470' r='95' fill='#FFFFFF'/><circle cx='2717' cy='1470' r='95' fill='#FFFFFF'/><circle cx='494' cy='1680' r='95' fill='#FFFFFF'/><circle cx='988' cy='1680' r='95' fill='#FFFFFF'/><circle cx='1482' cy='1680' r='95' fill='#FFFFFF'/><circle cx='1976' cy='1680' r='95' fill='#FFFFFF'/><circle cx='2470' cy='1680' r='95' fill='#FFFFFF'/><circle cx='247' cy='1890' r='95' fill='#FFFFFF'/><circle cx='741' cy='1890' r='95' fill='#FFFFFF'/><circle cx='1235' cy='1890' r='95' fill='#FFFFFF'/><circle cx='1729' cy='1890' r='95' fill='#FFFFFF'/><circle cx='2223' cy='1890' r='95' fill='#FFFFFF'/><circle cx='2717' cy='1890' r='95' fill='#FFFFFF'/></svg>"}
		        }
		    ),
		    // Para tablas y tooltips: SVG como texto (el # se codifica como %23)
		    ConBandera = Table.AddColumn(Fuente, "Bandera", each "data:image/svg+xml;utf8," & Text.Replace([SVG], "#", "%23"), type text),
		    // Para incrustar dentro de otro SVG (gráfico con banderas): la misma imagen en base64
		    ConBase64 = Table.AddColumn(ConBandera, "Bandera Base64", each "data:image/svg+xml;base64," & Binary.ToText(Text.ToBinary([SVG], TextEncoding.Utf8), BinaryEncoding.Base64), type text),
		    Resultado = Table.RemoveColumns(ConBase64, {"SVG"})
		in
		    Resultado
